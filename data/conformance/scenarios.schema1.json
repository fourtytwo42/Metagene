          "subject_id": "oc-163604cb5d88636b803053d952b4f897461d78b4387f1a65a771df48ad53cd71",
          "assertion": "The replacement effect doubles the token-copy event.",
          "ai_decision": false
        },
        {
          "card_name": "Mythos of Illuna",
          "subject_id": "oc-fa48b245816bc73c94b4338a1c38cdbd1891d90ff8b9c7c7d4238e2d896dfc9c",
          "assertion": "The spell legally targets Parallel Lives and creates token copies with copied characteristics.",
          "ai_decision": true
        }
      ],
      "initial_state": {
        "turn": 4,
        "phase": "precombat_main",
        "active_player": 1,
        "priority_player": 1,
        "players": [
          {
            "seat": 1,
            "life": 20,
            "mana_pool": {
              "green": 1,
              "blue": 3
            }
          },
          {
            "seat": 2,
            "life": 20
          }
        ],
        "objects": [
          {
            "alias": "parallel-lives",
            "card": "Parallel Lives",
            "owner": 1,
            "controller": 1,
            "zone": "battlefield"
          },
          {
            "alias": "mythos",
            "card": "Mythos of Illuna",
            "owner": 1,
            "zone": "hand"
          }
        ]
      },
      "actions": [
        {
          "sequence": 1,
          "actor": 1,
          "action": "cast",
          "source": "mythos",
          "targets": [
            "parallel-lives"
          ],
          "choices": {
            "spend": {
              "green": 1,
              "blue": 3
            }
          }
        },
        {
          "sequence": 2,
          "actor": 1,
          "action": "pass_priority"
        },
        {
          "sequence": 3,
          "actor": 2,
          "action": "pass_priority"
        },
        {
          "sequence": 4,
          "actor": 1,
          "action": "resolve_top"
        }
      ],
      "assertions": [
        {
          "path": "/battlefield/seat-1/cards/Parallel Lives/count",
          "operator": "equals",
          "expected": 3
        },
        {
          "path": "/battlefield/seat-1/tokens/Parallel Lives/count",
          "operator": "equals",
          "expected": 2
        },
        {
          "path": "/graveyard/seat-1/cards/Mythos of Illuna/count",
          "operator": "equals",
          "expected": 1
        }
      ],
