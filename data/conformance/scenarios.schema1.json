        "kinds": [
          "spell.cast",
          "replacement.applied",
          "token.created",
          "zone.changed"
        ],
        "payload_fields": {
          "replacement.applied": [
            "affected_event",
            "multiplier",
            "source_card"
          ],
          "token.created": [
            "card_name",
            "controller",
            "quantity"
          ],
          "zone.changed": [
            "card_name",
            "from",
            "to"
          ]
        }
      }
