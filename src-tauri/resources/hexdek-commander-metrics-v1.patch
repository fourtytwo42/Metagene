+func aggregateCommanderMetrics(metrics map[string]*CommanderMetricSummary, analysis *analytics.GameAnalysis) {
+	if analysis == nil {
+		return
+	}
+	for _, player := range analysis.Players {
+		summary := metrics[player.CommanderName]
+		if summary == nil {
+			summary = &CommanderMetricSummary{TargetActions: make(map[string]int)}
+			metrics[player.CommanderName] = summary
+		}
+		summary.Games++
+		if player.Won {
+			summary.Wins++
+		}
+		summary.LandsPlayed += player.LandsPlayed
+		summary.ManaSpent += player.ManaSpent
+		summary.ManaWasted += player.ManaWasted
+		summary.DamageDealt += player.DamageDealt
+		summary.DamageTaken += player.DamageTaken
+		summary.CreaturesLost += player.CreaturesLost
+		summary.CreaturesKilled += player.CreaturesKilled
+		summary.SpellsCast += player.SpellsCast
+		summary.CountersCast += player.CountersCast
+		summary.RemovalCast += player.RemovalCast
+		summary.PeakBoardSize += player.PeakBoardSize
+		summary.PeakLife += player.PeakLife
+		summary.FinalLife += player.FinalLife
+		if player.TurnOfDeath == 0 {
+			summary.Survived++
+		}
+	}
+	if analysis.Interactions == nil {
+		return
+	}
+	for source, row := range analysis.Interactions.Cells {
+		if source >= len(analysis.Interactions.SeatCommanders) {
+			continue
+		}
+		sourceName := analysis.Interactions.SeatCommanders[source]
+		summary := metrics[sourceName]
+		if summary == nil {
+			continue
+		}
+		total := 0
+		maximum := 0
+		maximumTarget := -1
+		winnerActions := 0
+		for target, cell := range row {
+			if target == source || target >= len(analysis.Interactions.SeatCommanders) {
+				continue
+			}
+			actions := cell.Attacks + cell.Counters
+			if cell.PlayerDamage > 0 {
+				actions++
+			}
+			if actions == 0 {
+				continue
+			}
+			targetName := analysis.Interactions.SeatCommanders[target]
+			summary.TargetActions[targetName] += actions
+			total += actions
+			if actions > maximum {
+				maximum = actions
+				maximumTarget = target
+			}
+			if target == analysis.WinnerSeat {
+				winnerActions = actions
+			}
+		}
+		// Conservative proxy: a losing player devoted at least 75% of three
+		// or more directed actions to another non-winner while applying less
+		// than half as much pressure to the eventual winner.
+		if source != analysis.WinnerSeat && total >= 3 && maximum*4 >= total*3 &&
+			maximumTarget != analysis.WinnerSeat && winnerActions*2 < maximum {
+			summary.KingmakingSignals++
+		}
+	}
+}
diff --git a/internal/tournament/metagene_compact_metrics_test.go b/internal/tournament/metagene_compact_metrics_test.go
new file mode 100644
--- /dev/null
+++ b/internal/tournament/metagene_compact_metrics_test.go
@@ -0,0 +1,43 @@
+package tournament
+
+import (
+	"testing"
+
+	"github.com/hexdek/hexdek/internal/analytics"
+)
+
+func TestAggregateCommanderMetricsTracksBehaviorAndKingmakingSignal(t *testing.T) {
+	metrics := map[string]*CommanderMetricSummary{
+		"Alpha": {TargetActions: map[string]int{}},
+		"Beta":  {TargetActions: map[string]int{}},
+		"Gamma": {TargetActions: map[string]int{}},
+	}
+	analysis := &analytics.GameAnalysis{
+		WinnerSeat: 2,
+		Players: []analytics.PlayerAnalysis{
+			{Seat: 0, CommanderName: "Alpha", ManaSpent: 8, ManaWasted: 2, DamageDealt: 6, DamageTaken: 12, RemovalCast: 2, PeakBoardSize: 5, FinalLife: 8},
+			{Seat: 1, CommanderName: "Beta"},
+			{Seat: 2, CommanderName: "Gamma", Won: true, TurnOfDeath: 0},
+		},
+		Interactions: &analytics.InteractionMatrix{
+			Seats:          3,
+			SeatCommanders: []string{"Alpha", "Beta", "Gamma"},
+			Cells: [][]analytics.InteractionCell{
+				{{}, {Attacks: 3, PlayerDamage: 6}, {}},
+				{{}, {}, {}},
+				{{}, {}, {}},
+			},
+		},
+	}
+	aggregateCommanderMetrics(metrics, analysis)
+	alpha := metrics["Alpha"]
+	if alpha.Games != 1 || alpha.ManaSpent != 8 || alpha.RemovalCast != 2 || alpha.PeakBoardSize != 5 {
+		t.Fatalf("unexpected Alpha aggregate: %+v", alpha)
+	}
+	if alpha.TargetActions["Beta"] != 4 {
+		t.Fatalf("target actions = %d, want 4", alpha.TargetActions["Beta"])
+	}
+	if alpha.KingmakingSignals != 1 {
+		t.Fatalf("kingmaking signals = %d, want 1", alpha.KingmakingSignals)
+	}
+}
