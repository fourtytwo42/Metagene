diff --git a/internal/hat/metagene_combo_plan.go b/internal/hat/metagene_combo_plan.go
new file mode 100644
index 0000000000000000000000000000000000000000..ed8bae5b60ca77758971e7b96d0e215496dec475
--- /dev/null
+++ b/internal/hat/metagene_combo_plan.go
@@ -0,0 +1,209 @@
+package hat
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// MetageneComboPlanFile is the versioned, deck-keyed strategy overlay emitted
+// by Metagene. It is deliberately smaller than Freya's strategy format: the
+// overlay only supplies proven combo lines and tutor priorities, then composes
+// with (rather than replacing) any native Freya profile.
+type MetageneComboPlanFile struct {
+	SchemaVersion int                     `json:"schema_version"`
+	Decks         []MetageneDeckComboPlan `json:"decks"`
+}
+
+// MetageneDeckComboPlan applies to one staged tournament deck. Deck is matched
+// against the staged file's base name, case-insensitively.
+type MetageneDeckComboPlan struct {
+	Deck          string              `json:"deck"`
+	ProofRevision string              `json:"proof_revision,omitempty"`
+	Plans         []MetageneComboLine `json:"plans"`
+	TutorTargets  []string            `json:"tutor_targets,omitempty"`
+}
+
+// MetageneComboLine is a proof-gated ComboPlan wire representation.
+type MetageneComboLine struct {
+	Pieces    []string `json:"pieces"`
+	Type      string   `json:"type"`
+	Class     string   `json:"class,omitempty"`
+	CastOrder []string `json:"cast_order,omitempty"`
+	Proof     string   `json:"proof"`
+}
+
+// LoadMetageneComboPlanFile validates a Metagene combo overlay. Invalid lines
+// are ignored conservatively; a malformed file returns an error so the caller
+// can log it and continue with ordinary Yggdrasil behavior.
+func LoadMetageneComboPlanFile(path string) (*MetageneComboPlanFile, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	var plans MetageneComboPlanFile
+	if err := json.Unmarshal(data, &plans); err != nil {
+		return nil, err
+	}
+	if plans.SchemaVersion != 1 {
+		return nil, fmt.Errorf("unsupported Metagene combo-plan schema %d", plans.SchemaVersion)
+	}
+	validDecks := make([]MetageneDeckComboPlan, 0, len(plans.Decks))
+	seenDecks := make(map[string]bool)
+	for _, deck := range plans.Decks {
+		deck.Deck = filepath.Base(strings.TrimSpace(deck.Deck))
+		key := strings.ToLower(deck.Deck)
+		if key == "" || seenDecks[key] {
+			continue
+		}
+		seenDecks[key] = true
+		validLines := make([]MetageneComboLine, 0, len(deck.Plans))
+		for _, line := range deck.Plans {
+			if validated, ok := validateMetageneComboLine(line); ok {
+				validLines = append(validLines, validated)
+			}
+		}
+		if len(validLines) == 0 {
+			continue
+		}
+		deck.Plans = validLines
+		deck.TutorTargets = uniqueNames(deck.TutorTargets)
+		validDecks = append(validDecks, deck)
+	}
+	plans.Decks = validDecks
+	return &plans, nil
+}
+
+// ForDeck returns the validated overlay for one staged deck, or nil when the
+// plan is stale/unmatched. Callers intentionally treat nil as normal play.
+func (plans *MetageneComboPlanFile) ForDeck(deckPath string) *MetageneDeckComboPlan {
+	if plans == nil {
+		return nil
+	}
+	key := strings.ToLower(filepath.Base(deckPath))
+	for i := range plans.Decks {
+		if strings.ToLower(plans.Decks[i].Deck) == key {
+			return &plans.Decks[i]
+		}
+	}
+	return nil
+}
+
+// ApplyMetageneComboPlan merges a proof-gated overlay into a Freya profile.
+// The resulting ComboPieces are priors only: Yggdrasil's ComboSequencer still
+// checks zones, mana and legal actions on every decision and falls back to its
+// ordinary evaluator whenever the line cannot be followed.
+func ApplyMetageneComboPlan(profile *StrategyProfile, overlay *MetageneDeckComboPlan) *StrategyProfile {
+	if overlay == nil || len(overlay.Plans) == 0 {
+		return profile
+	}
+	if profile == nil {
+		profile = &StrategyProfile{}
+	}
+	if profile.Archetype == "" {
+		profile.Archetype = "Combo"
+	}
+	if profile.CardRoles == nil {
+		profile.CardRoles = make(map[string]string)
+	}
+	seenPlans := make(map[string]bool)
+	for _, existing := range profile.ComboPieces {
+		seenPlans[comboPlanKey(existing.Pieces)] = true
+	}
+	priorities := append([]string{}, overlay.TutorTargets...)
+	for _, line := range overlay.Plans {
+		key := comboPlanKey(line.Pieces)
+		if seenPlans[key] {
+			continue
+		}
+		seenPlans[key] = true
+		profile.ComboPieces = append(profile.ComboPieces, ComboPlan{
+			Pieces:    append([]string{}, line.Pieces...),
+			Type:      line.Type,
+			Class:     line.Class,
+			CastOrder: append([]string{}, line.CastOrder...),
+		})
+		for _, piece := range line.Pieces {
+			profile.CardRoles[piece] = "Combo"
+			priorities = append(priorities, piece)
+		}
+	}
+	profile.TutorTargets = uniqueNames(append(priorities, profile.TutorTargets...))
+	if profile.GameplanSummary == "" {
+		profile.GameplanSummary = "Assemble and execute a Metagene-proven combo line."
+	}
+	return profile
+}
+
+func validateMetageneComboLine(line MetageneComboLine) (MetageneComboLine, bool) {
+	switch strings.ToLower(strings.TrimSpace(line.Proof)) {
+	case "symbolically_proven", "hexdek_executed", "cross_engine_verified", "arena_verified":
+	default:
+		return MetageneComboLine{}, false
+	}
+	line.Pieces = uniqueNames(line.Pieces)
+	if len(line.Pieces) < 2 || len(line.Pieces) > 5 {
+		return MetageneComboLine{}, false
+	}
+	line.Type = strings.ToLower(strings.TrimSpace(line.Type))
+	switch line.Type {
+	case "infinite", "determined", "finisher":
+	default:
+		return MetageneComboLine{}, false
+	}
+	line.Class = strings.ToLower(strings.TrimSpace(line.Class))
+	if len(line.CastOrder) == 0 {
+		line.CastOrder = append([]string{}, line.Pieces...)
+	} else {
+		line.CastOrder = uniqueNames(line.CastOrder)
+		pieceSet := make(map[string]bool, len(line.Pieces))
+		for _, piece := range line.Pieces {
+			pieceSet[strings.ToLower(piece)] = true
+		}
+		for _, card := range line.CastOrder {
+			if !pieceSet[strings.ToLower(card)] {
+				return MetageneComboLine{}, false
+			}
+		}
+		for _, piece := range line.Pieces {
+			if !containsName(line.CastOrder, piece) {
+				line.CastOrder = append(line.CastOrder, piece)
+			}
+		}
+	}
+	return line, true
+}
+
+func uniqueNames(names []string) []string {
+	seen := make(map[string]bool, len(names))
+	out := make([]string, 0, len(names))
+	for _, name := range names {
+		name = strings.TrimSpace(name)
+		key := strings.ToLower(name)
+		if name == "" || seen[key] {
+			continue
+		}
+		seen[key] = true
+		out = append(out, name)
+	}
+	return out
+}
+
+func containsName(names []string, wanted string) bool {
+	for _, name := range names {
+		if strings.EqualFold(name, wanted) {
+			return true
+		}
+	}
+	return false
+}
+
+func comboPlanKey(pieces []string) string {
+	normalized := make([]string, 0, len(pieces))
+	for _, piece := range pieces {
+		normalized = append(normalized, strings.ToLower(strings.TrimSpace(piece)))
+	}
+	return strings.Join(normalized, "\x00")
+}
