@@ -0,0 +1,82 @@
+package hat
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestMetageneComboPlan_LoadMergeAndFallback(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "combo-plan.json")
+	payload := `{
+  "schema_version": 1,
+  "decks": [{
+    "deck": "deck-0.txt",
+    "proof_revision": "combo-action-graph-v1",
+    "tutor_targets": ["Piece B"],
+    "plans": [
+      {"pieces":["Piece A","Piece B"],"type":"infinite","class":"infinite_damage","cast_order":["Piece A","Piece B"],"proof":"symbolically_proven"},
+      {"pieces":["Rumor A","Rumor B"],"type":"infinite","proof":"corpus_only"}
+    ]
+  }]
+}`
+	if err := os.WriteFile(path, []byte(payload), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	plans, err := LoadMetageneComboPlanFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := plans.ForDeck(filepath.Join(dir, "DECK-0.TXT")); got == nil || len(got.Plans) != 1 {
+		t.Fatalf("expected one proof-gated plan, got %#v", got)
+	}
+	if plans.ForDeck(filepath.Join(dir, "stale.txt")) != nil {
+		t.Fatal("stale deck key must fall back to ordinary play")
+	}
+	base := &StrategyProfile{Archetype: "Control", TutorTargets: []string{"Existing"}}
+	merged := ApplyMetageneComboPlan(base, plans.ForDeck("deck-0.txt"))
+	if merged.Archetype != "Control" || len(merged.ComboPieces) != 1 {
+		t.Fatalf("unexpected merged profile: %#v", merged)
+	}
+	if len(merged.TutorTargets) != 3 || merged.CardRoles["Piece A"] != "Combo" {
+		t.Fatalf("combo priorities were not merged: %#v", merged)
+	}
+	if ApplyMetageneComboPlan(merged, nil) != merged {
+		t.Fatal("nil overlay must preserve the normal strategy profile")
+	}
+}
+
+func TestMetageneComboPlan_RejectsMalformedOrUnsupportedLines(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "combo-plan.json")
+	payload := `{"schema_version":1,"decks":[{"deck":"deck.txt","plans":[
+      {"pieces":["Only One"],"type":"infinite","proof":"symbolically_proven"},
+      {"pieces":["A","B"],"type":"wishful","proof":"symbolically_proven"},
+      {"pieces":["A","B"],"type":"infinite","cast_order":["Not A Piece"],"proof":"symbolically_proven"}
+    ]}]}`
+	if err := os.WriteFile(path, []byte(payload), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	plans, err := LoadMetageneComboPlanFile(path)
